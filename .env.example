# Root env for docker-compose.yml (production / VM — API only).
# Copy to .env and fill in with your VM's existing Postgres.

# Opção A (recomendada): variáveis separadas.
PGHOST=precatur_database
PGPORT=5432
PGUSER=postgre
PGDATABASE=database-precatur
# Senha: se tiver caractere especial (# @ etc.), use base64 (à prova de parser):
#   printf '%s' 'SUA_SENHA' | base64
PGPASSWORD_B64=base64-da-sua-senha
# Se a senha for simples, pode usar crua: PGPASSWORD=sua-senha

# Opção B: URL única (escape @ -> %40, # -> %23 na senha). Use uma OU outra.
# DATABASE_URL=postgres://user:pass@host:5432/db
# Postgres com SSL: PGSSL=true (ou ?sslmode=require na URL)

PORT=8080

# Your Vercel frontend domain (comma-separated for multiple).
CORS_ORIGIN=https://seu-projeto.vercel.app

# Initial admin (created on first boot if no users exist). CHANGE THESE.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@precatur.com
ADMIN_PASSWORD=troque-esta-senha

# Long random string in production.
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_TTL=12h

# Create tables on boot (safe/idempotent).
MIGRATE_ON_START=true
# Seed demo leads. Set false in production (you'll use real data).
SEED_ON_START=false

# ── Calculadora de precatórios (motor Python interno) ──────────────────────
# Endereço do motor; no contêiner ele sobe junto, em 127.0.0.1:8090.
MOTOR_URL=http://127.0.0.1:8090
# Opcional: se definido, o motor só aceita chamadas com este segredo.
MOTOR_SEGREDO=
# Teto da chamada ao motor (ms). Leitura de PDF escaneado passa de 1 min.
MOTOR_TIMEOUT_MS=300000
# Leitura de PDF (pré-análise / assistente de corte). 1 liga.
PREFILL_ENABLED=
# Chave do modelo que extrai os campos dos documentos.
OPENROUTER_API_KEY=
# Envio ao card do Bitrix a partir da calculadora.
BITRIX_WEBHOOK=
BITRIX_PORTAL=
BITRIX_CATEGORIA=
# Hub opcional (snapshot/journal do envio). Sem ele tudo funciona.
HUB_URL=
HUB_USER=
HUB_PASS=

# ── Alfred — consulta de precatórios (serviço Python interno) ──────────────
ALFRED_URL=http://127.0.0.1:8610
# Segunda tranca entre o Express e o Alfred (o serviço já é só interno).
ALFRED_SEGREDO=
# Tokens do Alfred, um por PAPEL. Formato: <token>:<papel>:<rótulo>
# O papel 'leitor' vê CPF mascarado; 'completo' vê inteiro.
ALFRED_TOKENS=
ALFRED_TOKEN_LEITOR=
ALFRED_TOKEN_COMPLETO=
# Quais perfis DO APP recebem o papel 'completo'. Padrão: só admin.
ALFRED_PERFIS_COMPLETO=admin
ALFRED_TIMEOUT_MS=60000

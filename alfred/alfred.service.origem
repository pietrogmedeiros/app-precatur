[Unit]
Description=Alfred — consulta de precatorios (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/alfred
EnvironmentFile=/etc/alfred/env
ExecStart=/home/ubuntu/alfred/.venv/bin/uvicorn scripts.api:app --host 127.0.0.1 --port 8600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
